{
  "name": "lichtblick-docs-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server exposing the Lichtblick documentation and the @lichtblick/suite extension API to AI agents",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "lichtblick-docs-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@lichtblick/suite": "1.29.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "minisearch": "7.2.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vitest": "5.0.4"
  }
}
