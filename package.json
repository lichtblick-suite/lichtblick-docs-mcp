{
  "name": "@lichtblick/docs-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Lichtblick documentation and the @lichtblick/suite extension API to AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lichtblick",
    "robotics",
    "documentation",
    "ai"
  ],
  "homepage": "https://github.com/lichtblick-suite/lichtblick-docs-mcp#readme",
  "bugs": {
    "url": "https://github.com/lichtblick-suite/lichtblick-docs-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lichtblick-suite/lichtblick-docs-mcp.git"
  },
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "lichtblick-docs-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "npm-shrinkwrap.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node dist/index.js check",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lichtblick/suite": "1.30.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "minisearch": "7.2.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lichtblick/eslint-plugin": "2.0.7",
    "@types/node": "22.20.5",
    "@typescript-eslint/parser": "8.62.1",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.38.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@lichtblick/eslint-plugin": {
      "typescript": "$typescript"
    }
  }
}
